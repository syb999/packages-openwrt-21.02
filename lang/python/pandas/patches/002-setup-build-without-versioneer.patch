+# versioneer is a build requirement of the release process only (it derives the
+# version from git), while the sdist of a release carries a frozen
+# pandas/_version.py. When such an sdist is built with an older toolchain
+# (setuptools < 61 does not read the [project] table of pyproject.toml) neither
+# versioneer nor the PEP 621 metadata is available, so name and version are then
+# taken from the environment, the way the OpenWrt build system does with
+# PY_PKG_VERSION.
+try:
+    import versioneer
+except ImportError:
+    versioneer = None
+    # normally the versioneer command, which encodes the version info
+    from setuptools.command.sdist import sdist as _sdist
+
+    cmdclass = {"sdist": _sdist}
+else:
+    cmdclass = versioneer.get_cmdclass()
 
 
