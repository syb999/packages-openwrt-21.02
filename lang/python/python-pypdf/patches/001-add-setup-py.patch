--- /dev/null
+++ b/setup.py
@@ -0,0 +1,33 @@
+#!/usr/bin/env python3
+"""Minimal setup.py for building pypdf in the OpenWrt package framework.
+
+The pypdf sdist only ships a pyproject.toml using the flit_core backend, while
+the OpenWrt python3-package.mk build installs via "setup.py install".  The
+version is kept in pypdf/_version.py (generated by flit for the wheel/pypi
+metadata), so read it from there instead of duplicating it.
+"""
+
+import os
+import re
+
+from setuptools import find_packages, setup
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+
+with open(os.path.join(HERE, "pypdf", "_version.py"), encoding="utf-8") as f:
+    VERSION = re.search(r'__version__\s*=\s*"([^"]+)"', f.read()).group(1)
+
+setup(
+    name="pypdf",
+    version=VERSION,
+    description="A pure-python PDF library capable of splitting, merging, "
+                "cropping, and transforming PDF files",
+    license="BSD-3-Clause",
+    url="https://pypdf.readthedocs.io/",
+    python_requires=">=3.6",
+    packages=find_packages(exclude=["tests", "tests.*"]),
+    package_data={"pypdf": ["py.typed"]},
+    install_requires=[
+        "typing_extensions>=4.0; python_version < '3.11'",
+    ],
+)
